# direnv re-runs this script when any watched file changes. flake.nix and
# flake.lock are auto-watched by `use flake` (via nix-direnv); add the uv
# project metadata so the venv stays in sync with declared dependencies.
watch_file pyproject.toml uv.lock

# Nix flake (system tools: uv, just, gh, act, ...). Optional — if `nix`
# is not installed, this branch is skipped and the uv path below picks
# up the slack.
if has nix && [[ -f flake.nix ]]; then
  use flake
fi

# uv-managed Python virtual environment (ruff, mypy, pyright, cfn-lint,
# pytest, hypothesis, moto, ...). Works regardless of whether the Nix
# branch above ran.
#
# `uv sync --quiet` is a fast no-op when the venv is already in sync;
# when pyproject.toml or uv.lock change (and direnv re-runs us), it
# updates the venv to match.
if has uv; then
  uv sync --all-groups --quiet
fi

if [[ -d .venv ]]; then
  export VIRTUAL_ENV="$PWD/.venv"
  PATH_add "$VIRTUAL_ENV/bin"
fi
